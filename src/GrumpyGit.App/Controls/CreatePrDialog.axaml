<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GrumpyGit.App.ViewModels"
             x:Class="GrumpyGit.App.Controls.CreatePrDialog"
             x:DataType="vm:MainWindowViewModel">

    <Border Classes="card"
            Padding="{DynamicResource PadDialog}"
            MaxWidth="520"
            MaxHeight="560"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
        <StackPanel Spacing="16">

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Path Classes="icon lg accent" Data="{DynamicResource IconPullRequest}"/>
                <TextBlock Classes="title"
                           Text="Create Pull Request"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Title -->
            <StackPanel Spacing="6">
                <TextBlock Classes="strip-label" Text="TITLE"/>
                <TextBox Watermark="PR title…"
                         Text="{Binding NewPrTitle, Mode=TwoWay}"/>
            </StackPanel>

            <!-- Body -->
            <StackPanel Spacing="6">
                <TextBlock Classes="strip-label" Text="DESCRIPTION"/>
                <TextBox Watermark="Describe your changes…"
                         AcceptsReturn="True"
                         Height="120"
                         TextWrapping="Wrap"
                         Text="{Binding NewPrBody, Mode=TwoWay}"/>
            </StackPanel>

            <!-- Branches: base ← head, read as one statement -->
            <Grid ColumnDefinitions="*,Auto,*">
                <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock Classes="strip-label" Text="BASE BRANCH"/>
                    <ComboBox HorizontalAlignment="Stretch"
                              ItemsSource="{Binding Branches}"
                              SelectedItem="{Binding NewPrBaseBranch, Mode=TwoWay}"/>
                </StackPanel>

                <Path Grid.Column="1"
                      Classes="icon"
                      Data="{DynamicResource IconMerge}"
                      Margin="12,18,12,0"
                      VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Spacing="6">
                    <TextBlock Classes="strip-label" Text="HEAD BRANCH (CURRENT)"/>
                    <Border Classes="badge accent" HorizontalAlignment="Left" Padding="9,3">
                        <TextBlock Text="{Binding CurrentBranch}"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Draft toggle -->
            <CheckBox IsChecked="{Binding NewPrIsDraft, Mode=TwoWay}">
                <TextBlock Text="Create as draft" Classes="secondary"/>
            </CheckBox>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal"
                        Spacing="10"
                        HorizontalAlignment="Right"
                        Margin="0,4,0,0">
                <Button Classes="subtle"
                        Content="Cancel"
                        Command="{Binding CancelCreatePrCommand}"/>
                <Button Classes="primary"
                        Content="Create PR"
                        Command="{Binding SubmitPrCommand}"/>
            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>

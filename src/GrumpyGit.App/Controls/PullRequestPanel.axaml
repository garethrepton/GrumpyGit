<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GrumpyGit.App.ViewModels"
             x:Class="GrumpyGit.App.Controls.PullRequestPanel"
             x:DataType="vm:MainWindowViewModel">

    <UserControl.Styles>
        <!-- PR rows carry three stacked lines, so they need more room than the
             app-wide dense list default. -->
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="12,9"/>
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource BgOverlayBrush}">
        <Grid RowDefinitions="Auto,Auto,*">

            <!-- Header -->
            <Border Grid.Row="0" Classes="pane-header">
                <DockPanel>
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                DockPanel.Dock="Left">
                        <Path Classes="icon sm" Data="{DynamicResource IconPullRequest}"/>
                        <TextBlock Classes="strip-label" Text="PULL REQUESTS"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                Spacing="6"
                                DockPanel.Dock="Right"
                                HorizontalAlignment="Right">
                        <Button Classes="primary sm"
                                Content="New PR"
                                Command="{Binding ShowCreatePrCommand}"/>
                        <Button Classes="sm"
                                Command="{Binding RefreshPrsCommand}"
                                ToolTip.Tip="Refresh">
                            <Path Classes="icon sm" Data="{DynamicResource IconFetch}"/>
                        </Button>
                        <Button Classes="subtle icon-only"
                                Command="{Binding TogglePrPanelCommand}"
                                ToolTip.Tip="Close">
                            <Path Classes="icon sm" Data="{DynamicResource IconClose}"/>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Loading indicator -->
            <TextBlock Grid.Row="1"
                       Text="Loading pull requests…"
                       Classes="tertiary"
                       Margin="12,10"
                       IsVisible="{Binding IsLoadingPrs}"/>

            <Panel Grid.Row="2">
                <!-- Empty state -->
                <StackPanel Classes="empty-state"
                            IsVisible="{Binding !PullRequests.Count}">
                    <Path Classes="icon" Data="{DynamicResource IconPullRequest}"/>
                    <TextBlock Classes="empty-title" Text="No open pull requests"/>
                    <TextBlock Classes="empty-body"
                               Text="Push a branch, then open a PR to start a review."/>
                </StackPanel>

                <!-- PR List -->
                <ListBox Background="Transparent"
                         BorderThickness="0"
                         ItemsSource="{Binding PullRequests}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:PullRequestViewModel">
                            <StackPanel Spacing="4">
                                <!-- Title row -->
                                <DockPanel>
                                    <Border DockPanel.Dock="Right"
                                            Classes="badge"
                                            Margin="8,0,0,0"
                                            IsVisible="{Binding ShowDraftBadge}">
                                        <TextBlock Text="DRAFT"/>
                                    </Border>
                                    <TextBlock Text="{Binding DisplayTitle}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="{DynamicResource FontSizeBody}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <!-- Branch info -->
                                <TextBlock Text="{Binding BranchInfo}"
                                           Classes="mono tertiary"
                                           FontSize="{DynamicResource FontSizeLabel}"/>
                                <!-- Author + review state -->
                                <DockPanel>
                                    <TextBlock Text="{Binding AuthorInfo}"
                                               Classes="tertiary"
                                               FontSize="{DynamicResource FontSizeLabel}"/>
                                    <TextBlock Text="{Binding ReviewState}"
                                               Foreground="{DynamicResource AddFgBrush}"
                                               FontSize="{DynamicResource FontSizeLabel}"
                                               Margin="12,0,0,0"
                                               IsVisible="{Binding ReviewState, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </DockPanel>
                                <!-- Labels -->
                                <TextBlock Text="{Binding Labels}"
                                           Foreground="{DynamicResource WarnFgBrush}"
                                           FontSize="{DynamicResource FontSizeLabel}"
                                           IsVisible="{Binding Labels, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Panel>

        </Grid>
    </Border>
</UserControl>

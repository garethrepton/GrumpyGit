<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:aedit="using:AvaloniaEdit"
             x:Class="GrumpyGit.App.Controls.BlameViewer">

    <Grid ColumnDefinitions="280,1,*" Background="{DynamicResource EditorBgBrush}">

        <!-- Left gutter: blame annotations -->
        <Border Grid.Column="0" Background="{DynamicResource GutterBgBrush}">
            <Grid RowDefinitions="Auto,*">
                <Border Grid.Row="0" Classes="pane-header">
                    <TextBlock Classes="strip-label" Text="BLAME"/>
                </Border>
                <ScrollViewer Grid.Row="1"
                              x:Name="GutterScrollViewer"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="GutterItems">
                        <!-- Items are populated from code-behind -->
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Divider -->
        <Border Grid.Column="1"
                Background="{DynamicResource BorderSubtleBrush}"/>

        <!-- Right side: file content with syntax highlighting -->
        <Grid Grid.Column="2" RowDefinitions="Auto,*">
            <Border Grid.Row="0" Classes="pane-header">
                <TextBlock Classes="strip-label" Text="CONTENT"/>
            </Border>
            <aedit:TextEditor x:Name="ContentEditor"
                              Grid.Row="1"
                              IsReadOnly="True"
                              ShowLineNumbers="True"
                              FontFamily="{DynamicResource MonoFontFamily}"
                              FontSize="{DynamicResource FontSizeCode}"
                              WordWrap="False"
                              Background="{DynamicResource EditorBgBrush}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              LineNumbersForeground="{DynamicResource GutterFgBrush}"
                              BorderThickness="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"/>
        </Grid>

    </Grid>
</UserControl>

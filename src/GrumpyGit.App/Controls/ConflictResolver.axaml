<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GrumpyGit.App.ViewModels"
             x:Class="GrumpyGit.App.Controls.ConflictResolver"
             x:DataType="vm:MainWindowViewModel">

    <UserControl.Styles>
        <!-- The three panes are one component in three states, so they share a
             single treatment; only the header rule colour distinguishes them. -->
        <Style Selector="Border.conflict-pane">
            <Setter Property="Background" Value="{DynamicResource EditorBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>
        <Style Selector="TextBox.conflict-text">
            <Setter Property="Background" Value="{DynamicResource EditorBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCode}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <!-- The editable pane sits one step lighter so it reads as the target -->
        <Style Selector="TextBox.conflict-text.editable">
            <Setter Property="Background" Value="{DynamicResource BgSunkenBrush}"/>
        </Style>
    </UserControl.Styles>

    <Border Classes="card"
            Padding="16"
            MaxWidth="1400"
            MaxHeight="800"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
        <Grid RowDefinitions="Auto,*,Auto">

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            Spacing="10">
                    <Path Classes="icon danger" Data="{DynamicResource IconAlert}"/>
                    <TextBlock Text="Conflict Resolver"
                               Classes="subtitle"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ConflictFilePath}"
                               Classes="mono tertiary"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button DockPanel.Dock="Right"
                        Classes="danger sm"
                        Content="Abort Merge"
                        Command="{Binding AbortMergeCommand}"
                        HorizontalAlignment="Right"/>
            </DockPanel>

            <!-- Three-column diff view -->
            <Grid Grid.Row="1"
                  ColumnDefinitions="*,1,*,1,*"
                  MinHeight="400">

                <!-- Left: Ours -->
                <Border Grid.Column="0" Classes="conflict-pane">
                    <Grid RowDefinitions="Auto,*">
                        <Border Grid.Row="0" Classes="section-header staged">
                            <TextBlock Classes="strip-label" Text="OURS (CURRENT BRANCH)"/>
                        </Border>
                        <TextBox Grid.Row="1"
                                 Classes="conflict-text"
                                 Text="{Binding ConflictOursContent}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"/>
                    </Grid>
                </Border>

                <!-- Splitter -->
                <Border Grid.Column="1" Background="{DynamicResource BorderSubtleBrush}"/>
                <GridSplitter Grid.Column="1"
                              Classes="hairline"
                              ResizeDirection="Columns"
                              VerticalAlignment="Stretch"/>

                <!-- Center: Result (editable) -->
                <Border Grid.Column="2" Classes="conflict-pane">
                    <Grid RowDefinitions="Auto,*">
                        <Border Grid.Row="0" Classes="section-header unstaged">
                            <TextBlock Classes="strip-label" Text="RESULT (EDITABLE)"/>
                        </Border>
                        <TextBox Grid.Row="1"
                                 Classes="conflict-text editable"
                                 Text="{Binding ConflictResultContent, Mode=TwoWay}"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"/>
                    </Grid>
                </Border>

                <!-- Splitter -->
                <Border Grid.Column="3" Background="{DynamicResource BorderSubtleBrush}"/>
                <GridSplitter Grid.Column="3"
                              Classes="hairline"
                              ResizeDirection="Columns"
                              VerticalAlignment="Stretch"/>

                <!-- Right: Theirs -->
                <Border Grid.Column="4" Classes="conflict-pane">
                    <Grid RowDefinitions="Auto,*">
                        <Border Grid.Row="0" Classes="section-header conflict">
                            <TextBlock Classes="strip-label" Text="THEIRS (INCOMING BRANCH)"/>
                        </Border>
                        <TextBox Grid.Row="1"
                                 Classes="conflict-text"
                                 Text="{Binding ConflictTheirsContent}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Action buttons. "Mark Resolved" is the completion action, so it
                 is the only accent; the three "accept" choices stay peers. -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        Spacing="8"
                        Margin="0,14,0,0"
                        HorizontalAlignment="Center">
                <Button Content="Accept Ours"
                        Command="{Binding AcceptOursCommand}"/>
                <Button Content="Accept Theirs"
                        Command="{Binding AcceptTheirsCommand}"/>
                <Button Content="Accept Both"
                        Command="{Binding AcceptBothCommand}"/>
                <Border Classes="divider" Margin="8,4"/>
                <Button Classes="primary"
                        Command="{Binding MarkResolvedCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Path Classes="icon sm" Data="{DynamicResource IconCheck}"/>
                        <TextBlock Text="Mark Resolved" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

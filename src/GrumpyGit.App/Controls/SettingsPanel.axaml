<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GrumpyGit.App.ViewModels"
             x:Class="GrumpyGit.App.Controls.SettingsPanel"
             x:DataType="vm:MainWindowViewModel">

    <UserControl.Styles>
        <!-- Every field is a 130px label beside a stretched input, so the whole
             form shares one baseline grid instead of each row inventing one. -->
        <Style Selector="Grid.field > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <Border Classes="card"
            Padding="{DynamicResource PadDialog}"
            MaxWidth="520"
            MaxHeight="560"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
        <Grid RowDefinitions="Auto,*,Auto">

            <!-- Header -->
            <TextBlock Grid.Row="0"
                       Classes="title"
                       Text="Settings"
                       Margin="0,0,0,18"/>

            <!-- Settings form -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          MaxHeight="400">
                <StackPanel Spacing="18">

                    <!-- Git Identity -->
                    <StackPanel Spacing="6">
                        <TextBlock Classes="strip-label" Text="GIT IDENTITY"/>

                        <Grid Classes="field" ColumnDefinitions="130,*" Margin="0,4,0,0">
                            <TextBlock Grid.Column="0" Text="user.name"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding SettingsGitUserName, Mode=TwoWay}"/>
                        </Grid>

                        <Grid Classes="field" ColumnDefinitions="130,*">
                            <TextBlock Grid.Column="0" Text="user.email"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding SettingsGitUserEmail, Mode=TwoWay}"/>
                        </Grid>
                    </StackPanel>

                    <!-- Repository -->
                    <StackPanel Spacing="6">
                        <TextBlock Classes="strip-label" Text="REPOSITORY"/>

                        <Grid Classes="field" ColumnDefinitions="130,*" Margin="0,4,0,0">
                            <TextBlock Grid.Column="0" Text="Default remote"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding SettingsDefaultRemote, Mode=TwoWay}"/>
                        </Grid>

                        <Grid Classes="field" ColumnDefinitions="130,*">
                            <TextBlock Grid.Column="0" Text="Auto-fetch (sec)"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding SettingsAutoFetchInterval, Mode=TwoWay}"
                                     Watermark="0 = disabled"/>
                        </Grid>
                    </StackPanel>

                    <!-- Local review. Off unless a model file is chosen: the app ships no
                         weights, downloads none, and works exactly as before without one. -->
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="strip-label" Text="LOCAL REVIEW" VerticalAlignment="Center"/>
                            <Border Classes="badge warn">
                                <TextBlock Text="EXPERIMENTAL"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Classes="caption tertiary"
                                   TextWrapping="Wrap"
                                   Text="Experimental. The review is a suggestion, not a verdict — it will miss real bugs and flag things that are fine, so read the diff yourself. Behaviour and the model list may change between releases; the git side is unaffected."/>

                        <!-- Which module, before anything about any one module's setup.
                             The fields below only mean something once Local is the answer,
                             and putting the choice under them read as a footnote. -->
                        <Grid Classes="field" ColumnDefinitions="130,*,Auto" Margin="0,4,0,0">
                            <TextBlock Grid.Column="0" Text="Reviewed by"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ActiveModuleName}"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="2"
                                    Classes="sm"
                                    Content="Change…"
                                    Margin="6,0,0,0"
                                    Command="{Binding ShowModulePickerCommand}"/>
                        </Grid>

                        <TextBlock Classes="caption tertiary"
                                   TextWrapping="Wrap"
                                   Text="{Binding ReviewPrivacyLine}"/>

                        <TextBlock Classes="caption tertiary"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding UsesLocalModule}"
                                   Text="Point at a GGUF model file, or download one below. No prompt, diff or answer is written to disk. Qwen2.5-Coder-1.5B-Instruct (Q4_K_M) is a good starting point."/>

                        <Grid Classes="field" ColumnDefinitions="130,*,Auto,Auto" Margin="0,4,0,0"
                              IsVisible="{Binding UsesLocalModule}">
                            <TextBlock Grid.Column="0" Text="Model file"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding SettingsLocalModelPath, Mode=TwoWay}"
                                     Watermark="none — local review off"/>
                            <Button Grid.Column="2"
                                    Classes="sm"
                                    Content="Browse…"
                                    Margin="6,0,0,0"
                                    Command="{Binding ChooseLocalModelCommand}"/>
                            <Button Grid.Column="3"
                                    Classes="subtle sm"
                                    Content="Clear"
                                    Margin="6,0,0,0"
                                    Command="{Binding ClearLocalModelCommand}"/>
                        </Grid>

                        <!-- The model library. Every entry is a fixed URL on one host with a
                             published checksum; Download is the only button in the whole
                             application that opens a socket to anything but git.exe.
                             Hidden unless the local module is the one in use — a user on
                             Copilot has no use for a GGUF and should not be offered one. -->
                        <TextBlock Classes="strip-label" Text="MODELS" Margin="0,10,0,0"
                                   IsVisible="{Binding UsesLocalModule}"/>

                        <TextBlock Classes="caption tertiary"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding UsesLocalModule}"
                                   Text="{Binding ModelLibraryFootprint}"/>

                        <ItemsControl ItemsSource="{Binding ModelLibrary}"
                                      IsVisible="{Binding UsesLocalModule}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:CompileBindings="False">
                                    <Border Classes="field" Padding="8,6" Margin="0,0,0,4">
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                                                <TextBlock Text="{Binding Name}"/>
                                                <TextBlock Text="{Binding StateLabel}" Classes="caption tertiary"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="0" Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        Spacing="4"
                                                        VerticalAlignment="Center">
                                                <Button Classes="sm"
                                                        Content="Use"
                                                        IsVisible="{Binding CanUse}"
                                                        Command="{Binding UseCommand}"/>
                                                <Button Classes="sm"
                                                        Content="Download"
                                                        IsVisible="{Binding CanDownload}"
                                                        Command="{Binding DownloadCommand}"/>
                                                <Button Classes="subtle sm"
                                                        Content="Delete"
                                                        IsVisible="{Binding CanDelete}"
                                                        Command="{Binding DeleteCommand}"/>
                                            </StackPanel>

                                            <ProgressBar Grid.Row="1" Grid.ColumnSpan="2"
                                                         Margin="0,6,0,0"
                                                         Minimum="0" Maximum="1"
                                                         Value="{Binding Progress}"
                                                         IsVisible="{Binding IsBusy}"/>

                                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2"
                                                       Margin="0,4,0,0"
                                                       Classes="caption tertiary"
                                                       TextWrapping="Wrap"
                                                       Text="{Binding Summary}"/>

                                            <!-- Said before the download, not after it. -->
                                            <TextBlock Grid.Row="3" Grid.ColumnSpan="2"
                                                       Margin="0,4,0,0"
                                                       Classes="caption"
                                                       Foreground="{DynamicResource WarnFgBrush}"
                                                       TextWrapping="Wrap"
                                                       IsVisible="{Binding ExceedsMachineMemory}"
                                                       Text="{Binding MemoryWarning}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Classes="subtle sm"
                                Content="Cancel download"
                                HorizontalAlignment="Left"
                                IsVisible="{Binding IsDownloadingModel}"
                                Command="{Binding CancelModelDownloadCommand}"/>
                    </StackPanel>

                    <!-- Editor -->
                    <StackPanel Spacing="6">
                        <TextBlock Classes="strip-label" Text="EDITOR"/>

                        <Grid Classes="field" ColumnDefinitions="130,*" Margin="0,4,0,0">
                            <TextBlock Grid.Column="0" Text="Font size"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding SettingsTerminalFontSize, Mode=TwoWay}"/>
                        </Grid>

                        <Grid Classes="field" ColumnDefinitions="130,*">
                            <TextBlock Grid.Column="0" Text="Diff context lines"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding SettingsDiffContextLines, Mode=TwoWay}"/>
                        </Grid>
                    </StackPanel>

                    <!-- Appearance -->
                    <StackPanel Spacing="6">
                        <TextBlock Classes="strip-label" Text="APPEARANCE"/>

                        <Grid Classes="field" ColumnDefinitions="130,*" Margin="0,4,0,0">
                            <TextBlock Grid.Column="0" Text="Theme"/>
                            <ComboBox Grid.Column="1"
                                      SelectedItem="{Binding SettingsTheme, Mode=TwoWay}"
                                      HorizontalAlignment="Left"
                                      MinWidth="140">
                                <x:String>Dark</x:String>
                                <x:String>Light</x:String>
                            </ComboBox>
                        </Grid>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- Buttons -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        Spacing="10"
                        HorizontalAlignment="Right"
                        Margin="0,18,0,0">
                <Button Classes="subtle"
                        Content="Cancel"
                        Command="{Binding CancelSettingsCommand}"/>
                <Button Classes="primary"
                        Content="Save"
                        Command="{Binding SaveSettingsCommand}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

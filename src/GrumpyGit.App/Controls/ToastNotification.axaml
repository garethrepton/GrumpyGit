<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GrumpyGit.App.Controls.ToastNotification"
             IsHitTestVisible="True">

    <Border x:Name="ToastBorder"
            Classes="toast"
            Padding="0"
            MinWidth="300"
            MaxWidth="440"
            Margin="0,0,0,8"
            Opacity="0"
            ClipToBounds="True"
            Cursor="Hand">
        <Grid ColumnDefinitions="3,Auto,*,Auto">

            <!-- Severity rail: carries the colour so the icon can stay legible -->
            <Border x:Name="SeverityRail" Grid.Column="0"/>

            <Path x:Name="SeverityIcon"
                  Grid.Column="1"
                  Classes="icon"
                  Margin="12,0,0,0"
                  VerticalAlignment="Center"/>

            <TextBlock Grid.Column="2"
                       x:Name="MessageText"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="{DynamicResource FontSizeSmall}"
                       Margin="10,12,8,12"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="3"
                    Classes="subtle icon-only"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    ToolTip.Tip="Dismiss"
                    Click="OnCloseClick">
                <Path Classes="icon sm" Data="{DynamicResource IconClose}"/>
            </Button>
        </Grid>
    </Border>
</UserControl>

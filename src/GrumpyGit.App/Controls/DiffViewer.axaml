<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:aedit="using:AvaloniaEdit"
             xmlns:controls="using:GrumpyGit.App.Controls"
             x:Class="GrumpyGit.App.Controls.DiffViewer">

    <Panel>

    <!-- ── Single-column pane: ghost view and blink comparator ──────────────────
         Both are one editor over one document, so they share this pane and differ
         only in what gets loaded into it. Hidden entirely in side-by-side mode. -->
    <Grid x:Name="SingleColumnRoot"
          RowDefinitions="Auto,*"
          IsVisible="False"
          Background="{DynamicResource EditorBgBrush}">
        <Border Grid.Row="0" Classes="pane-header">
            <StackPanel Orientation="Horizontal" Spacing="7">
                <Border Width="7" Height="7"
                        CornerRadius="2"
                        VerticalAlignment="Center"
                        Background="{DynamicResource AddFgBrush}"/>
                <TextBlock x:Name="SingleColumnLabel" Classes="strip-label" Text="GHOST"/>
                <TextBlock x:Name="SingleColumnHint"
                           Classes="strip-label"
                           Opacity="0.65"
                           Text=""/>
            </StackPanel>
        </Border>
        <aedit:TextEditor x:Name="SingleEditor"
                          Grid.Row="1"
                          IsReadOnly="True"
                          ShowLineNumbers="True"
                          FontFamily="{DynamicResource MonoFontFamily}"
                          FontSize="{DynamicResource FontSizeCode}"
                          WordWrap="False"
                          Background="{DynamicResource EditorBgBrush}"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          LineNumbersForeground="{DynamicResource GutterFgBrush}"
                          BorderThickness="0"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"/>
    </Grid>

    <!-- Editors, then a fixed-width minimap strip showing where every change sits
         in the whole file — essential once full-file mode makes the document long. -->
    <Grid x:Name="SideBySideRoot"
          ColumnDefinitions="*,1,*,Auto" Background="{DynamicResource EditorBgBrush}">

        <!-- Left side: old / removed -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*">
            <Border Grid.Row="0" Classes="pane-header">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <!-- Legend swatch: this side carries removals -->
                    <Border Width="7" Height="7"
                            CornerRadius="2"
                            VerticalAlignment="Center"
                            Background="{DynamicResource DeleteFgBrush}"/>
                    <TextBlock Classes="strip-label" Text="BEFORE"/>
                </StackPanel>
            </Border>
            <Panel Grid.Row="1">
                <aedit:TextEditor x:Name="LeftEditor"
                                  IsReadOnly="True"
                                  ShowLineNumbers="True"
                                  FontFamily="{DynamicResource MonoFontFamily}"
                                  FontSize="{DynamicResource FontSizeCode}"
                                  WordWrap="False"
                                  Background="{DynamicResource EditorBgBrush}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  LineNumbersForeground="{DynamicResource GutterFgBrush}"
                                  BorderThickness="0"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"/>
                <Canvas x:Name="HunkButtonCanvas" IsHitTestVisible="True" />
            </Panel>
        </Grid>

        <!-- Divider -->
        <Border Grid.Column="1"
                Background="{DynamicResource BorderSubtleBrush}"/>

        <!-- Right side: new / added -->
        <Grid Grid.Column="2" RowDefinitions="Auto,*">
            <Border Grid.Row="0" Classes="pane-header">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <!-- Legend swatch: this side carries additions -->
                    <Border Width="7" Height="7"
                            CornerRadius="2"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AddFgBrush}"/>
                    <TextBlock Classes="strip-label" Text="AFTER"/>
                </StackPanel>
            </Border>
            <aedit:TextEditor x:Name="RightEditor"
                              Grid.Row="1"
                              IsReadOnly="True"
                              ShowLineNumbers="True"
                              FontFamily="{DynamicResource MonoFontFamily}"
                              FontSize="{DynamicResource FontSizeCode}"
                              WordWrap="False"
                              Background="{DynamicResource EditorBgBrush}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              LineNumbersForeground="{DynamicResource GutterFgBrush}"
                              BorderThickness="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"/>
        </Grid>

        <!-- ── Change minimap ──────────────────────────────────────────────── -->
        <Grid Grid.Column="3" RowDefinitions="Auto,*" Width="14">
            <Border Grid.Row="0" Classes="pane-header"/>
            <controls:DiffMinimap x:Name="Minimap"
                                  Grid.Row="1"
                                  Cursor="Hand"
                                  ToolTip.Tip="Click or drag to jump to a change"/>
        </Grid>

    </Grid>

    </Panel>
</UserControl>
